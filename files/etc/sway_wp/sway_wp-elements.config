# sway_wp-elements.config: what the sway_wp.py wallpaper explains, and in which order.
#
# One element name per line. Put a # in front of a line to hide that element;
# a hidden element is not computed at all (its sources are never read).
# The order of lines is the reading order on the wallpaper. Where an element
# sits in general is fixed by the element itself:
#   top    = full width, under the bar
#   flow   = newspaper columns, in the order listed here
#   bottom = full width, at the bottom edge
#
# To change it for your user only, copy this file to
#   ~/.config/sway_wp/sway_wp-elements.config
# (that copy wins). Changes apply on the next sway reload (Super+Shift+c).
#
# `sway_wp.py --list` prints every element with the sources it reads.
# If everything does not fit, the sheet zooms out (shown as "zoom" in the header).

# --- frame -------------------------------------------------------------------
header             # top:    title + live session facts (mod, layout, output, sway version)

# --- what you press ----------------------------------------------------------
bindings           # flow:   every bindsym/bindcode, grouped by config file / comment section

# --- how sway draws windows ----------------------------------------------------
sway.windows       # flow:   each client.* colour class rendered as a real sway window
sway.layout        # flow:   miniature workspace: gaps, tabbed + split containers, focus states
sway.font          # flow:   titlebar font, Pango metrics, resulting titlebar height (+ live check)
sway.decoration    # flow:   default_border, titlebar_padding/_border_thickness, title_align, ...
sway.gaps          # flow:   inner / outer gaps, smart_gaps
#sway.colors       # flow:   every client.* colour as a swatch (repeats sway.windows as a table)
sway.behaviour     # flow:   focus_follows_mouse, mouse_warping, tiling_drag, floating limits, ...

# --- everything else that styles the screen ------------------------------------
bar                # flow:   waybar modules in their CSS colours + bar geometry (swaybar: live colours)
notifications      # flow:   dunst low / normal / critical notifications
launcher           # flow:   rofi list rows in the resolved theme
lockscreen         # flow:   swaylock indicator in all its states
nagbar             # flow:   swaynag bar (the exit confirmation) + error type
terminal           # flow:   foot font, padding, 16-colour palette

# --- hardware as sway sees it ------------------------------------------------
sway.output        # flow:   outputs: mode, scale, transform, subpixel, background
sway.input         # flow:   keyboards (layout, repeat) and pointers (accel, scrolling)
sway.seat          # flow:   cursor theme and size

# --- where it all came from ----------------------------------------------------
sources            # flow:   every file read for this image, what it fed, when it changed
compose            # bottom: German letters on the US layout (Compose sequences + Ctrl+Shift+U)
